# ==============================================================================
# ENVIRONMENT CONFIGURATION - SOHAM AEER PORTFOLIO
# Copy this file to .env.local for local development or set in Vercel Dashboard.
# NEVER commit .env.local or secret-bearing credentials to Git.
# ==============================================================================

# Public Production URL (used for canonical URLs, Open Graph, and sitemap generation)
NEXT_PUBLIC_SITE_URL=https://sohamaeer.vercel.app

# SMTP Configuration for Nodemailer Contact Form System
# Recommended providers: Gmail App Password, Brevo (Sendinblue), Resend SMTP, or private business webmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username-or-email@gmail.com
SMTP_PASS=your-secure-app-password

# Email Routing Destinations
CONTACT_TO_EMAIL=sohamayer516@gmail.com
CONTACT_FROM_EMAIL="Soham Aeer Portfolio" <your-verified-sender@domain.com>

# Optional standalone Express server port (for Linux VPS deployment)
PORT=5000
CLIENT_URL=https://sohamaeer.vercel.app
